nd":28},"hero$9046e81b-95a9-4930-b2d3-aacc4fb8f484","hero",{"variation":86,"version":87,"items":121,"primary":122,"id":242,"slice_type":243,"slice_label":5},[],{"title":123,"body":132,"bento":136},[124],{"type":125,"text":126,"spans":127,"direction":95},"heading2","Un Art Martial pour tous.",[128],{"start":129,"end":130,"type":131},15,24,"em",[133],{"type":98,"text":134,"spans":135,"direction":95},"Nous accueillons tous ceux qui souhaitent pratiquer avec nous cet art ancestral.",[],[137,162,204,228],{"title":138,"body":143,"image":153,"is_wide":40},[139],{"type":140,"text":141,"spans":142,"direction":95},"heading3","De tous niveaux",[],[144,147,150],{"type":98,"text":145,"spans":146,"direction":95},"Tous les aïkidokas du dojo pratiquent ensemble. ",[],{"type":98,"text":148,"spans":149,"direction":95},"Ainsi, chacun, qu'il soit débutant ou plus gradé, enrichit son expérience au contact de l'autre.",[],{"type":98,"text":151,"spans":152,"direction":95},"Vous pouvez commencer à tout moment dans la saison. Les pré-requis de base sont répétés systématiquement à l'échauffement et en début de cours, avant d'aborder des techniques plus élaborées.",[],{"dimensions":154,"alt":5,"copyright":5,"url":157,"id":158,"edit":159},{"width":155,"height":156},240,144,"https:\u002F\u002Fimages.prismic.io\u002Faikido-traditionnel-cotiere\u002FagD1CqYofJOwHC2-_38f9e50d-0f99-4915-a3bb-ed75ddaf9e18.png?auto=format%2Ccompress&rect=241%2C0%2C1019%2C611&w=240&h=144","agD1CqYofJOwHC2-",{"x":160,"y":26,"zoom":161,"background":28},241,1.5699999999999998,{"title":163,"body":167,"image":196,"is_wide":203},[164],{"type":140,"text":165,"spans":166,"direction":95},"Adultes et ados de +14 ans",[],[168,174,180,185],{"type":98,"text":169,"spans":170,"direction":95},"Deux séances par semaine :",[171],{"start":26,"end":172,"type":173},4,"strong",{"type":98,"text":175,"spans":176,"direction":95},"- Le LUNDI (19h45-22h00) et ",[177],{"start":178,"end":179,"type":173},5,10,{"type":98,"text":181,"spans":182,"direction":95},"- Le MERCREDI (19h30-22h00).",[183],{"start":178,"end":184,"type":173},13,{"type":98,"text":186,"spans":187,"direction":95},"De septembre à mi-juillet (sauf pendant les vacances de Noël).",[188,191,193],{"start":189,"end":190,"type":173},3,12,{"start":129,"end":192,"type":173},25,{"start":194,"end":195,"type":131},27,60,{"dimensions":197,"alt":5,"copyright":5,"url":199,"id":200,"edit":201},{"width":198,"height":156},552,"https:\u002F\u002Fimages.prismic.io\u002Faikido-traditionnel-cotiere\u002Faf9VjaYofJOwHCJi_stagebourg2017.jpg?auto=format%2Ccompress&rect=0%2C77%2C968%2C253&w=552&h=144","af9VjaYofJOwHCJi",{"x":26,"y":202,"zoom":27,"background":28},77,true,{"title":205,"body":209,"image":222,"is_wide":203},[206],{"type":140,"text":207,"spans":208,"direction":95},"Enfants (+8 ans)",[],[210,215],{"type":98,"text":211,"spans":212,"direction":95},"Des séances le SAMEDI matin de 10h30 à 12h00.",[213],{"start":129,"end":214,"type":173},21,{"type":98,"text":216,"spans":217,"direction":95},"De septembre à mi-juillet (sauf pendant les vacances scolaires).",[218,219,220],{"start":189,"end":190,"type":173},{"start":129,"end":192,"type":173},{"start":194,"end":221,"type":131},62,{"dimensions":223,"alt":5,"copyright":5,"url":224,"id":225,"edit":226},{"width":198,"height":156},"https:\u002F\u002Fimages.prismic.io\u002Faikido-traditionnel-cotiere\u002FagLVD6YofJOwHG27_WhatsAppImage2026-03-03at1.44.23PM-1-.jpeg?auto=format%2Ccompress&rect=0%2C47%2C1600%2C417&w=552&h=144","agLVD6YofJOwHG27",{"x":26,"y":227,"zoom":27,"background":28},47,{"title":229,"body":233,"image":237,"is_wide":40},[230],{"type":140,"text":231,"spans":232,"direction":95},"De tous âges",[],[234],{"type":98,"text":235,"spans":236,"direction":95},"Nos pratiquants ont entre 8 et 75 ans (à ce jour) ! Il n'y a pas d'âge pour débuter ou se perfectionner.",[],{"dimensions":238,"alt":5,"copyright":5,"url":239,"id":240,"edit":241},{"width":155,"height":156},"https:\u002F\u002Fimages.prismic.io\u002Faikido-traditionnel-cotiere\u002FagD25aYofJOwHC3F_060d7885-914a-4eb7-a278-fdf9d7473f13.png?auto=format%2Ccompress&rect=0%2C0%2C1600%2C960&w=240&h=144","agD25aYofJOwHC3F",{"x":26,"y":26,"zoom":27,"background":28},"bento$78c85834-d325-47b1-9a09-fd75e2dccee9","bento",{"variation":86,"version":87,"items":245,"primary":246,"id":273,"slice_type":274,"slice_label":5},[],{"title":247,"image":251,"icon":258,"punchline":259,"body":263,"cta":270},[248],{"type":125,"text":249,"spans":250,"direction":95},"L’Harmonie en Mouvement à Dagneux",[],{"dimensions":252,"alt":5,"copyright":5,"url":255,"id":256,"edit":257},{"width":253,"height":254},508,357,"https:\u002F\u002Fimages.prismic.io\u002Faikido-traditionnel-cotiere\u002FagLZLaYofJOwHG4l_bokkenr_t.png?auto=format,compress","agLZLaYofJOwHG4l",{"x":26,"y":26,"zoom":27,"background":28},"noto:martial-arts-uniform",[260],{"type":140,"text":261,"spans":262,"direction":95},"Découvrez un art martial authentique où la force devient souplesse, au cœur d'une ambiance familiale et passionnée.",[],[264,267],{"type":98,"text":265,"spans":266,"direction":95},"Et si votre plus belle victoire était celle que vous remportiez sur vous-même ? Rejoignez-nous sur le tatami pour transformer votre énergie et cultiver la sérénité.",[],{"type":98,"text":268,"spans":269,"direction":95},"L'idéal pour vous rendre compte si cet art martial vous plaît est de venir l'essayer gratuitement et sans engagement. Deux cours d'essai vous sont proposés.",[],{"link_type":103,"key":271,"url":109,"text":272},"23203e95-3868-4e04-b856-c2e2f1817d60","VENEZ ESSAYER !","showcase$c21c1cae-fc21-41dc-b51e-47ec482364d0","showcase",{"variation":86,"version":87,"items":276,"primary":277,"id":373,"slice_type":45,"slice_label":5},[],{"title":278,"body":282,"focuses":286},[279],{"type":125,"text":280,"spans":281,"direction":95},"Notre enseignement",[],[283],{"type":98,"text":284,"spans":285,"direction":95},"Découvrez notre pratique de l'Aïkido",[],[287,307,331,348],{"link":288},{"id":44,"type":45,"tags":289,"lang":14,"slug":47,"first_publication_date":48,"last_publication_date":49,"uid":50,"url":51,"data":290,"link_type":38,"key":306,"isBroken":40},[],{"title":291,"description":295,"cover":299},[292],{"type":92,"text":293,"spans":294,"direction":95},"L'aïkido",[],[296],{"type":98,"text":297,"spans":298,"direction":95},"Ici, pas de compétition. Nous cultivons le respect, l'entraide et la recherche de l'équilibre. Inspirés par l'enseignement de notre regretté Sensei Jimmy, nous perpétuons une tradition où chaque pratiquant progresse à son rythme.",[],{"dimensions":300,"alt":5,"copyright":5,"url":303,"id":304,"edit":305},{"width":301,"height":302},2816,1536,"https:\u002F\u002Fimages.prismic.io\u002Faikido-traditionnel-cotiere\u002FagMA6aYofJOwHHj0_Gemini_Generated_Image_ap8q70ap8q70ap8q.png?auto=format,compress","agMA6aYofJOwHHj0",{"x":26,"y":26,"zoom":27,"background":28},"9c2ca518-d39e-497f-897e-70313d700f7a",{"link":308},{"id":309,"type":45,"tags":310,"lang":14,"slug":311,"first_publication_date":312,"last_publication_date":313,"uid":314,"url":315,"data":316,"link_type":38,"key":330,"isBroken":40},"agLgwRAAACcATZZo",[],"la-pratique-des-3-armes","2026-05-12T08:41:52+0000","2026-08-24T15:25:20+0000","la-pratique-des--armes","\u002Ffocus\u002Fla-pratique-des--armes",{"title":317,"description":321,"cover":325},[318],{"type":92,"text":319,"spans":320,"direction":95},"La pratique des 3 armes",[],[322],{"type":98,"text":323,"spans":324,"direction":95},"Nous enseignons l'Aïkido dans sa globalité. Vous apprendrez le maniement du Bokken (sabre en bois), du Jo (bâton) et du Tanto (couteau), piliers indispensables pour comprendre les déplacements et la précision des techniques à mains nues.",[],{"dimensions":326,"alt":5,"copyright":5,"url":327,"id":328,"edit":329},{"width":301,"height":302},"https:\u002F\u002Fimages.prismic.io\u002Faikido-traditionnel-cotiere\u002FagLnvKYofJOwHHC5_Gemini_Generated_Image_qp7a9eqp7a9eqp7a.png?auto=format,compress","agLnvKYofJOwHHC5",{"x":26,"y":26,"zoom":27,"background":28},"cb5ce3cf-536d-49fa-9c9a-bf4313dd1bf3",{"link":332},{"id":333,"type":45,"tags":334,"lang":14,"slug":335,"first_publication_date":336,"last_publication_date":336,"uid":335,"url":337,"data":338,"link_type":38,"key":347,"isBroken":40},"agMA-hAAACgATcz3",[],"une-ambiance-unique","2026-05-12T10:29:33+0000","\u002Ffocus\u002Fune-ambiance-unique",{"title":339,"description":343},[340],{"type":92,"text":341,"spans":342,"direction":95},"Une Ambiance Unique",[],[344],{"type":98,"text":345,"spans":346,"direction":95},"Le Dojo de la Côtière, c'est avant tout une \"famille\". On y vient pour la rigueur technique, on y reste pour la convivialité et la bienveillance des membres.",[],"f6217efd-8ead-44d3-90cc-94120c20a4cb",{"link":349},{"id":350,"type":45,"tags":351,"lang":14,"slug":352,"first_publication_date":353,"last_publication_date":354,"uid":352,"url":355,"data":356,"link_type":38,"key":372,"isBroken":40},"agMBFBAAANw7Tc0r",[],"proximite","2026-05-12T10:30:29+0000","2026-06-23T13:45:09+0000","\u002Ffocus\u002Fproximite",{"title":357,"description":361,"cover":365},[358],{"type":92,"text":359,"spans":360,"direction":95},"Proximité",[],[362],{"type":98,"text":363,"spans":364,"direction":95},"Situé à la Salle des Bâtonnes à Dagneux, chemin de Marigneux, notre dojo est le point de rencontre privilégié pour tous les habitants de la Côtière ou d'ailleurs souhaitant évacuer le stress du quotidien.",[],{"dimensions":366,"alt":5,"copyright":5,"url":369,"id":370,"edit":371},{"width":367,"height":368},800,500,"https:\u002F\u002Fimages.prismic.io\u002Faikido-traditionnel-cotiere\u002FagMBQKYofJOwHHkU_159840_270_salle-d-escalade.png?auto=format,compress","agMBQKYofJOwHHkU",{"x":26,"y":26,"zoom":27,"background":28},"2b0ae61b-1414-4a6a-8ab1-408bd7fa6829","focuses$84af60d5-62eb-4a1f-9413-1563e00fadc9",{"variation":86,"version":87,"items":375,"primary":376,"id":394,"slice_type":377,"slice_label":5},[],{"anchor":377,"title":378,"address":385,"email":389,"ifra